# themoment-ai-harness-sync 동기화 설정
# 이 파일을 sync.yml로 이름을 바꾸고 .harness/ 디렉터리에 배치하세요
#
# 사용 가능한 그룹: claude, codex, gemini, copilot
# 전체 항목 목록: sync-manifest.yml 참고 (id 기준)
#
# 이 파일이 없으면 기본값(claude, codex, gemini)이 적용됩니다

# 포함할 그룹 (생략하면 기본값 적용)
groups:
  - claude
  - codex
  - gemini
  # - copilot

# 위 그룹에서 제외할 항목 (sync-manifest.yml의 id 사용)
# exclude:
#   - claude/skills/kotest-guide       # Kotest 쓰지 않는 프로젝트
#   - claude/skills/kotlin-spring-arch  # Kotlin/Spring 아닌 프로젝트
#   - codex/skills/kotest-guide
#   - codex/skills/kotlin-spring-arch

# 그룹에 없어도 추가할 항목
# include:
#   - copilot/instructions

# 동기화 PR 설정 (선택 — 생략하면 기본값 적용)
# branch_prefix: harness-sync   # 기본값: harness-sync
# base_branch: develop          # 기본값: 레포의 기본 브랜치 (main 또는 master)