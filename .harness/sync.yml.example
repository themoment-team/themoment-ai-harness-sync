# themoment-ai-harness-sync 동기화 설정
# 이 파일을 sync.yml로 이름을 바꾸고 .harness/ 디렉터리에 배치하세요
#
# 사용 가능한 그룹: claude, codex, gemini, copilot
# 전체 항목 목록: sync-manifest.yml 참고 (id 기준)
#
# 이 파일이 없으면 기본값(claude, codex, gemini)이 적용됩니다

# 포함할 그룹 (생략하면 기본값 적용)
groups:
  - claude
  - codex
  - gemini
  # - copilot

# 개별 항목 활성화/비활성화 (sync-manifest.yml의 id 기준)
# - false: 그룹에 포함된 항목을 제외
# - true:  그룹에 없는 opt-in 항목을 추가
# overrides:
#   claude/skills/git-commit: false        # 이 스킬은 받지 않음
#   claude/skills/kotlin-spring-arch: false
#   codex/skills/git-commit: false
#   codex/skills/kotlin-spring-arch: false
#
# ── Hook 모듈 (기본 비포함, true로 활성화 필요) ──────────────────────────
#   claude/hooks/dispatcher: true   # 훅 사용 시 필수
#   claude/settings: true           # 훅 사용 시 필수
#   claude/hooks/logging: true
#   claude/hooks/command-guard: true
#   claude/hooks/ktlint: true       # Kotlin 프로젝트
#   claude/hooks/kotest: true       # Kotlin 프로젝트
#   claude/hooks/secret-guard: true
#   claude/hooks/biome: true        # JS/TS 프로젝트
#   claude/hooks/eslint: true       # JS/TS 프로젝트
#   claude/hooks/jest: true         # JS/TS 프로젝트
#   claude/hooks/vitest: true       # JS/TS 프로젝트
#   claude/hooks/ts-check: true     # TypeScript 프로젝트
#   claude/hooks/prettier: true     # JS/TS 프로젝트
#   claude/hooks/spotless: true     # Java/Kotlin 프로젝트
#   claude/hooks/ruff: true         # Python 프로젝트
#   claude/skills/git-commit: "v1"  # 특정 버전 고정 (아카이브에 해당 버전이 있어야 함)
#   codex/hooks/dispatcher: true
#   codex/hooks-json: true
#   codex/hooks/logging: true
#   codex/hooks/command-guard: true
#   codex/hooks/ktlint: true
#   codex/hooks/kotest: true
#   codex/hooks/secret-guard: true

# 동기화 PR 설정 (선택 — 생략하면 기본값 적용)
# branch_prefix: harness-sync/  # 기본값: harness-sync/ (슬래시 포함하여 명시)
# base_branch: develop          # 기본값: 레포의 기본 브랜치 (main 또는 master)
