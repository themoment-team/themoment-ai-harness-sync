# GitHub App의 Client ID와 Client Secret
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub App의 숫자 App ID와 Generate a private key로 발급한 PEM 전문
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# openssl rand -base64 32로 생성한 세션 암호화 키
AUTH_SECRET=

# AI Harness 원본 저장소 (owner/repository)
HARNESS_REPOSITORY=themoment-team/themoment-ai-harness-sync
